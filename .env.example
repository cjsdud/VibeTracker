# --- 필수 ---
DATABASE_URL=postgresql://vibetrack:vibetrack@localhost:5432/vibetrack
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
APP_URL=http://localhost:5173

# --- 선택 ---
PORT=3001
NODE_ENV=development
# true면 데모 로그인 / 데모 데이터 / GitHub 이벤트 시뮬레이션 활성화
DEMO_MODE=true
# false면 API 프로세스 내 Job worker를 끈다 (Render Background Worker 분리 시)
INLINE_WORKER=true

# --- GitHub App (없어도 DEMO_MODE로 동작) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- 테스트 ---
TEST_DATABASE_URL=postgresql://vibetrack:vibetrack@localhost:5432/vibetrack_test
